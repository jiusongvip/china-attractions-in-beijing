---
import Icons from "./Icons.astro";
---

<header id="site-header" class="fixed top-0 z-50 w-full bg-[#f8f7f4]/90 backdrop-blur-md border-b border-[#d5d0c4]/40 transition-all duration-300">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 py-4 lg:py-5">
    <a href="/" class="relative z-10 flex items-center gap-3 group">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-white text-sm font-bold shadow-lg shadow-[#0f766e]/15 transition-all group-hover:shadow-xl group-hover:shadow-[#0f766e]/20 group-hover:scale-105">
        <Icons name="building-castle" size={18} />
      </span>
      <span class="text-lg font-bold tracking-tight text-[#0f766e]">Beijing Attractions</span>
    </a>
    <ul class="hidden items-center gap-1 text-sm font-medium md:flex">
      <li><a href="/#must-do" class="nav-link relative px-4 py-2 rounded-full text-[#5c5a4c] transition-all duration-300 hover:text-[#0f766e] hover:bg-[#ccfbf1]/30">Attractions<span class="nav-indicator"></span></a></li>
      <li><a href="/things-to-do/" class="nav-link relative px-4 py-2 rounded-full text-[#5c5a4c] transition-all duration-300 hover:text-[#0f766e] hover:bg-[#ccfbf1]/30">Things to Do<span class="nav-indicator"></span></a></li>
      <li><a href="/collections/beijing-3-day-itinerary/" class="nav-link relative px-4 py-2 rounded-full text-[#5c5a4c] transition-all duration-300 hover:text-[#0f766e] hover:bg-[#ccfbf1]/30">Itineraries<span class="nav-indicator"></span></a></li>
      <li><a href="/#compare-guides" class="nav-link relative px-4 py-2 rounded-full text-[#5c5a4c] transition-all duration-300 hover:text-[#0f766e] hover:bg-[#ccfbf1]/30">Compare<span class="nav-indicator"></span></a></li>
      <li><a href="/subway-guide/" class="nav-link relative px-4 py-2 rounded-full text-[#5c5a4c] transition-all duration-300 hover:text-[#0f766e] hover:bg-[#ccfbf1]/30">Subway<span class="nav-indicator"></span></a></li>
      <li><a href="/blog/" class="nav-link relative px-4 py-2 rounded-full text-[#5c5a4c] transition-all duration-300 hover:text-[#0f766e] hover:bg-[#ccfbf1]/30">Blog<span class="nav-indicator"></span></a></li>
      <li class="ml-3">
        <a href="/collections/beijing-3-day-itinerary/" class="rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-[#0f766e]/15 transition-all hover:shadow-lg hover:shadow-[#0f766e]/20 hover:scale-105">
          Plan My Trip
        </a>
      </li>
    </ul>
    <button id="mobile-menu-btn" class="md:hidden relative z-10 flex h-10 w-10 items-center justify-center rounded-xl bg-white/80 backdrop-blur border border-[#d5d0c4] text-[#0f766e]" aria-label="Toggle menu" aria-expanded="false">
      <Icons name="menu" size={20} />
    </button>
  </nav>
  <div id="mobile-menu" class="hidden border-b border-[#d5d0c4] bg-white/95 backdrop-blur-xl px-6 py-6 md:hidden">
    <ul class="space-y-1 text-sm font-medium">
      <li><a href="/#must-do" class="block rounded-xl px-4 py-3 text-[#5c5a4c] transition-all hover:bg-[#ccfbf1]/30 hover:text-[#0f766e]">Attractions</a></li>
      <li><a href="/things-to-do/" class="block rounded-xl px-4 py-3 text-[#5c5a4c] transition-all hover:bg-[#ccfbf1]/30 hover:text-[#0f766e]">Things to Do</a></li>
      <li><a href="/collections/beijing-3-day-itinerary/" class="block rounded-xl px-4 py-3 text-[#5c5a4c] transition-all hover:bg-[#ccfbf1]/30 hover:text-[#0f766e]">Itineraries</a></li>
      <li><a href="/#compare-guides" class="block rounded-xl px-4 py-3 text-[#5c5a4c] transition-all hover:bg-[#ccfbf1]/30 hover:text-[#0f766e]">Compare</a></li>
      <li><a href="/subway-guide/" class="block rounded-xl px-4 py-3 text-[#5c5a4c] transition-all hover:bg-[#ccfbf1]/30 hover:text-[#0f766e]">Subway</a></li>
      <li><a href="/blog/" class="block rounded-xl px-4 py-3 text-[#5c5a4c] transition-all hover:bg-[#ccfbf1]/30 hover:text-[#0f766e]">Blog</a></li>
      <li class="pt-3 mt-1 border-t border-[#d5d0c4]">
        <a href="/collections/beijing-3-day-itinerary/" class="block rounded-full bg-gradient-to-r from-[#0f766e] to-[#2dd4bf] px-4 py-3 text-center font-semibold text-white">Plan My Trip</a>
      </li>
    </ul>
  </div>
</header>

<style is:global>
  #site-header.nav-scrolled {
    background: rgba(248, 247, 244, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(181, 176, 165, 0.2);
  }
</style>