---
const year = new Date().getFullYear();
import Icons from "./Icons.astro";
---

<div class="mountain-divider"></div>

<footer class="relative z-10 bg-gradient-to-b from-[#edeae3] to-[#f8f7f4] pt-16 pb-12">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 md:grid-cols-4">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-white text-sm font-bold">
            <Icons name="building-castle" size={18} />
          </span>
          <span class="text-lg font-bold tracking-tight text-[#0f766e]">Beijing Attractions</span>
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-[#5c5a4c]">Independent travel guide to Beijing's best attractions. Real ticket prices, subway exits, and honest recommendations from the Great Wall to hidden hutongs.</p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#2dd4bf] mb-4">Explore</p>
        <ul class="space-y-3 text-sm">
          <li><a href="/attractions/forbidden-city/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Forbidden City</a></li>
          <li><a href="/attractions/great-wall-mutianyu/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Great Wall</a></li>
          <li><a href="/attractions/temple-of-heaven/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Temple of Heaven</a></li>
          <li><a href="/attractions/summer-palace/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Summer Palace</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#d4a373] mb-4">Plan</p>
        <ul class="space-y-3 text-sm">
          <li><a href="/collections/beijing-3-day-itinerary/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">3-Day Itinerary</a></li>
          <li><a href="/#compare-guides" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Attraction Comparisons</a></li>
          <li><a href="/best-time/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Best Time to Visit</a></li>
          <li><a href="/subway-guide/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Subway Guide</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#78716c] mb-4">Essentials</p>
        <ul class="space-y-3 text-sm">
          <li><a href="/faq/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Visa & FAQ</a></li>
          <li><a href="/#food" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">What to Eat</a></li>
          <li><a href="/#stay" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Where to Stay</a></li>
          <li><a href="/blog/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">Travel Blog</a></li>
          <li><a href="/about/" class="text-[#5c5a4c] transition-colors hover:text-[#0f766e]">About</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-[#d5d0c4] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[#5c5a4c]/60">&copy; {year} Beijing Attractions. Independent travel guide. Not affiliated with any tour agency or hotel.</p>
      <p class="text-xs text-[#5c5a4c]/60">china-attractions-in-beijing.com</p>
    </div>
  </div>
</footer>