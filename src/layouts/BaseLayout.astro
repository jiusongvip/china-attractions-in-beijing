---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = "/images/og-default.svg", noindex = false } = Astro.props;
const canonical = Astro.url.pathname === '/'
  ? new URL('/', Astro.site).href.replace(/\/$/, '')
  : new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) — injected after window load to keep it off the critical path -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.addEventListener('load', function () {
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-W8991N7D1T';
      s.async = true;
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-W8991N7D1T');
    });
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-latin-400-normal.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-serif-display-latin-400-normal.woff2" crossorigin />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(image, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "China Attractions in Beijing",
      "url": "https://www.china-attractions-in-beijing.com",
      "description": "Complete 2026 guide to Beijing's best attractions. Ticket prices, subway directions, seasonal tips, and honest recommendations from the Great Wall to hidden hutongs.",
      "inLanguage": "en",
      "publisher": {
        "@type": "Organization",
        "name": "China Attractions in Beijing",
        "url": "https://www.china-attractions-in-beijing.com",
        "logo": "https://www.china-attractions-in-beijing.com/favicon.svg"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "China Attractions in Beijing",
      "url": "https://www.china-attractions-in-beijing.com",
      "logo": "https://www.china-attractions-in-beijing.com/favicon.svg",
      "description": "Independent travel guide to Beijing attractions with firsthand reviews, practical tips, and up-to-date ticket and transit information.",
      "email": "hello@china-attractions-in-beijing.com",
      "foundingDate": "2026",
      "areaServed": { "@type": "City", "name": "Beijing" },
      "sameAs": [
        "https://github.com/jiusongvip/china-attractions-in-beijing"
      ]
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-base-50 text-base-900 antialiased">
  <Header />
  <main class="flex-1 relative z-10 pt-[68px]">
    <slot />
  </main>
  <Footer />
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll('[data-email-user]').forEach(a => {
        a.href = 'mailto:' + a.getAttribute('data-email-user') + '@' + a.getAttribute('data-email-domain');
      });
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      if (btn && menu) {
        btn.addEventListener("click", () => {
          const open = menu.classList.toggle("hidden");
          btn.setAttribute("aria-expanded", String(!open));
        });
        document.addEventListener("click", (e) => {
          if (!btn.contains(e.target) && !menu.contains(e.target)) {
            menu.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
          }
        });
      }
      const reducer = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (!reducer.matches) {
        const revealEls = document.querySelectorAll('.scroll-reveal');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach(el => {
          observer.observe(el);
        });
      } else {
        document.querySelectorAll('.scroll-reveal').forEach(el => el.classList.add('visible'));
      }
      const headerEl = document.getElementById('site-header');
      window.addEventListener('scroll', () => {
        if (headerEl) {
          headerEl.classList.toggle('nav-scrolled', window.scrollY > 40);
        }
      }, { passive: true });
    });
  </script>
</body>
</html>
