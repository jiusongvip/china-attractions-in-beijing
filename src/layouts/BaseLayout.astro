---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/images/og-default.svg" } = Astro.props;
const rawPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(rawPath, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(image, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "China Attractions in Beijing",
      "url": "https://china-attractions-in-beijing.com",
      "description": "Complete 2026 guide to Beijing's best attractions. Ticket prices, subway directions, seasonal tips, and honest recommendations from the Great Wall to hidden hutongs.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://china-attractions-in-beijing.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "China Attractions in Beijing",
      "url": "https://china-attractions-in-beijing.com",
      "description": "Independent travel guide to Beijing attractions with firsthand reviews, practical tips, and up-to-date ticket and transit information.",
      "email": "hello@china-attractions-in-beijing.com",
      "foundingDate": "2026",
      "areaServed": { "@type": "City", "name": "Beijing" }
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-base-50 text-base-900">
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
