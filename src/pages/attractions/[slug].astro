---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icons from "../../components/Icons.astro";
import { getAttractionBySlug, attractions } from "../../data/attractions";

export function getStaticPaths() {
  return attractions.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const a = getAttractionBySlug(slug as string);
if (!a) return Astro.redirect("/404");

const pageTitle = a.name + " Beijing: Tickets & Tips [2026]";
const pageDesc = "Planning your visit to " + a.name + " in Beijing? Our 2026 guide: ticket prices, opening hours, subway routes, highlights, and crowd-avoidance tips.";
const fmtPrice = (lo: number, hi: number) => lo === hi ? "CNY " + lo : "CNY " + lo + " – CNY " + hi;
const related = attractions.filter((x) => x.type === a.type && x.slug !== a.slug).slice(0, 3);
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"TouristAttraction",
    "name":a.name,
    "description":a.description,
    "url":new URL(Astro.url.pathname, Astro.site).href,
    "image":new URL("/images/attractions/" + a.slug + ".webp", Astro.site).href,
    "address":{"@type":"PostalAddress","addressLocality":"Beijing","addressRegion":"Beijing","addressCountry":"CN"},
    "geo":a.district ? {"@type":"GeoCoordinates","addressLocality":a.district,"addressCountry":"CN"} : undefined,
    "isAccessibleForFree":a.freeEntry,
    "publicAccess":true,
    "touristType":a.familyFriendly?["Families","Adults"]:["Adults"],
    "offers":a.freeEntry ? undefined : {"@type":"Offer","price":a.ticketLow.toString(),"priceCurrency":"CNY"}
  })}></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"BreadcrumbList",
    "itemListElement":[
      {"@type":"ListItem","position":1,"name":"Home","item":new URL("/", Astro.site).href},
      {"@type":"ListItem","position":2,"name":a.type.charAt(0).toUpperCase()+a.type.slice(1),"item":new URL("/type/"+a.type, Astro.site).href},
      {"@type":"ListItem","position":3,"name":a.name}
    ]
  })}></script>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-sm text-base-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
      <Icons name="chevron-right" size={14} />
      <a href={"/#" + a.type} class="hover:text-accent">{a.type.charAt(0).toUpperCase() + a.type.slice(1)}</a>
      <Icons name="chevron-right" size={14} />
      <span class="text-base-900">{a.name}</span>
    </nav>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-8">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-base-900 mb-3">{a.name}</h1>
    <div class="flex flex-wrap items-center gap-3 text-sm text-base-500 mb-4">
      <span class="flex items-center gap-1 text-amber-600 font-medium"><Icons name="star" size={16} />{a.rating}</span>
      <span class="flex items-center gap-1"><Icons name="clock" size={16} />{a.duration}</span>
      <span class="flex items-center gap-1"><Icons name="ticket" size={16} />{a.freeEntry ? "Free Entry" : fmtPrice(a.ticketLow, a.ticketHigh)}</span>
      {a.unesco && <span class="px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">UNESCO World Heritage</span>}
    </div>
    <p class="text-base text-base-600 leading-relaxed">{a.description}</p>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <div class="border border-base-200 rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <tbody>
          <tr class="border-b border-base-100"><td class="px-4 py-3 font-medium text-base-700 w-40"><span class="flex items-center gap-2"><Icons name="ticket" size={16} />Ticket Price</span></td><td class="px-4 py-3 text-base-600">{a.freeEntry ? "Free entry" : fmtPrice(a.ticketLow, a.ticketHigh)}</td></tr>
          <tr class="border-b border-base-100"><td class="px-4 py-3 font-medium text-base-700"><span class="flex items-center gap-2"><Icons name="clock" size={16} />Duration</span></td><td class="px-4 py-3 text-base-600">{a.duration}</td></tr>
          {a.subway && <tr class="border-b border-base-100"><td class="px-4 py-3 font-medium text-base-700"><span class="flex items-center gap-2"><Icons name="train" size={16} />Nearest Subway</span></td><td class="px-4 py-3 text-base-600">{a.subway}{a.subwayLine ? " (" + a.subwayLine + ")" : ""}{a.subwayExit ? ", Exit " + a.subwayExit : ""}</td></tr>}
          <tr class="border-b border-base-100"><td class="px-4 py-3 font-medium text-base-700"><span class="flex items-center gap-2"><Icons name="calendar" size={16} />Best Season</span></td><td class="px-4 py-3 text-base-600">{a.bestSeason.length === 1 && a.bestSeason[0] === "all" ? "Year-round" : a.bestSeason.map((s: string) => s.charAt(0).toUpperCase() + s.slice(1)).join(", ")}</td></tr>
          <tr><td class="px-4 py-3 font-medium text-base-700"><span class="flex items-center gap-2"><Icons name="users" size={16} />Best For</span></td><td class="px-4 py-3 text-base-600">{a.familyFriendly ? "All visitors, including families" : "Adults and active travelers"}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  {a.highlights.length > 0 && (
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
      <h2 class="text-xl font-semibold mb-4">Must-See Highlights</h2>
      <ul class="space-y-2">
        {a.highlights.map((h: string) => (
          <li class="flex items-start gap-2 text-base-600"><Icons name="check" size={18} class="text-accent mt-0.5 shrink-0" /><span>{h}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <h2 class="text-xl font-semibold mb-4">How to Get There</h2>
    <p class="text-base-600 leading-relaxed mb-4">
      {a.subway ? <>Take <strong>{a.subwayLine}</strong> to <strong>{a.subway}</strong> station{a.subwayExit ? " (Exit " + a.subwayExit + ")" : ""}. The attraction entrance is a short walk from the station.</> : "This attraction is best reached by bus or taxi. See the route details in the table above."}
    </p>
    <p class="text-sm text-base-500">Beijing subway operates from approximately 5am to 11pm daily. Fares range from CNY 3 to 9. English signage and announcements are available on all lines.</p>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <h2 class="text-xl font-semibold mb-4">Insider\u2019s Tip</h2>
    <div class="border-l-4 border-accent pl-4 py-2 bg-accent-bg/30 rounded-r">
      <p class="text-base text-base-700 leading-relaxed">{a.insiderTip}</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <h2 class="text-xl font-semibold mb-4">A Bit of History</h2>
    <p class="text-base text-base-600 leading-relaxed">{a.historyBlurb}</p>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <h2 class="text-xl font-semibold mb-4">Beat the Crowds</h2>
    <div class="flex items-start gap-3"><Icons name="clock" size={20} class="text-accent mt-0.5 shrink-0" /><p class="text-base text-base-600 leading-relaxed">{a.crowdTip}</p></div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <h2 class="text-xl font-semibold mb-4">Where to Eat Nearby</h2>
    <div class="flex items-start gap-3"><Icons name="map-pin" size={20} class="text-accent mt-0.5 shrink-0" /><p class="text-base text-base-600 leading-relaxed">{a.nearbyEats}</p></div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <h2 class="text-xl font-semibold mb-4">Best Photo Spot</h2>
    <div class="flex items-start gap-3"><Icons name="star" size={20} class="text-accent mt-0.5 shrink-0" /><p class="text-base text-base-600 leading-relaxed">{a.bestPhotoSpot}</p></div>
  </section>

  {related.length > 0 && (
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 border-t border-base-200 pt-8">
      <h2 class="text-xl font-semibold mb-4">More {a.type.charAt(0).toUpperCase() + a.type.slice(1)} Attractions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {related.map((r: typeof a) => (
          <a href={"/attractions/" + r.slug} class="card group block p-4">
            <h3 class="font-medium text-base-900 group-hover:text-accent transition-colors mb-1">{r.name}</h3>
            <p class="text-xs text-base-500">{r.duration} &middot; {r.freeEntry ? "Free" : "CNY " + r.ticketLow + "-" + r.ticketHigh}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
