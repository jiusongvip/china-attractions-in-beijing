---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Beijing Travel Collections: Guides for Every Traveler" description="Curated collections of Beijing attractions for every travel style. 3-day itineraries, family-friendly guides, budget tips, and free attractions.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-16">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-base-900 mb-8">Curated Collections</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/collections/beijing-3-day-itinerary" class="card group block p-6">
        <h3 class="font-semibold text-base-900 group-hover:text-accent transition-colors mb-2">3-Day Beijing Itinerary</h3>
        <p class="text-sm text-base-500">The perfect first-timer's plan</p>
      </a>
      <a href="/collections/beijing-with-kids" class="card group block p-6">
        <h3 class="font-semibold text-base-900 group-hover:text-accent transition-colors mb-2">Beijing with Kids</h3>
        <p class="text-sm text-base-500">Family-friendly attractions</p>
      </a>
      <a href="/collections/free-beijing-attractions" class="card group block p-6">
        <h3 class="font-semibold text-base-900 group-hover:text-accent transition-colors mb-2">Free Beijing Attractions</h3>
        <p class="text-sm text-base-500">World-class sights at no cost</p>
      </a>
    </div>
  </div>
</BaseLayout>
