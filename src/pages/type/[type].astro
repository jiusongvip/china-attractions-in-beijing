---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AttractionCard from "../../components/AttractionCard.astro";
import { getAttractionsByType, typeLabels, typeIntros } from "../../data/attractions";

export function getStaticPaths() {
  return Object.keys(typeLabels).filter((type) => getAttractionsByType(type).length > 0).map((type) => ({ params: { type } }));
}

const { type } = Astro.params;
const label = typeLabels[type as string];
const items = getAttractionsByType(type as string);
if (!label || items.length === 0) return Astro.redirect("/404");

const pageTitle = label.label + " in Beijing: What to Know [2026]";
const pageDesc = label.label + " in Beijing — ticket prices, opening hours, subway directions, and practical tips for international travelers visiting in 2026.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Breadcrumb items={[{ label: "Attractions", href: "/#must-do" }, { label: label.label }]} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-6">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-base-900 mb-3">{label.label} in Beijing</h1>
    <p class="text-lg text-base-500 leading-relaxed mb-4">{items.length} attraction{items.length > 1 ? "s" : ""} in this category</p>
    {typeIntros[type as string] && <p class="text-base text-base-600 leading-relaxed max-w-3xl mb-8">{typeIntros[type as string]}</p>}
  </div>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-base-900 mb-6">All {label.label} Attractions</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((a) => <AttractionCard attraction={a} />)}
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-base-900 mb-4">Practical Tips for Visiting {label.label} Sites in Beijing</h2>
    <div class="max-w-3xl space-y-4 text-base text-base-600 leading-relaxed">
      <p>Tickets for {label.label.toLowerCase()} attractions in Beijing are best booked online in advance &mdash; the Forbidden City and National Museum in particular sell out days ahead during peak season. Bring your passport: it is required for entry at every major site, and tickets are issued per passport number.</p>
      <p>Mornings are consistently quieter across all categories. Most sites open at 8 or 8:30am, and tour groups typically arrive from 9:30am onward. Nearly all indoor {label.label.toLowerCase()} venues close on Mondays, while parks and temples stay open year-round.</p>
      <p>The subway covers almost every attraction on this page &mdash; fares run CNY 3-9 with full English signage. Check our <a href="/subway-guide/" class="text-accent hover:underline font-medium">subway guide</a> for station exits, and the <a href="/blog/cost-of-beijing-trip/" class="text-accent hover:underline font-medium">cost guide</a> for budgeting your visit.</p>
    </div>
  </section>
</BaseLayout>
