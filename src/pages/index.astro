---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icons from "../components/Icons.astro";
import { attractions } from "../data/attractions";

const pageTitle = "China Attractions in Beijing: Plan Your Trip [2026]";
const pageDesc = "Plan your Beijing trip with confidence. Pre-trip checklist, attraction comparisons, subway directions, and curated itineraries — all in one guide.";

const days = [
  { n: 1, kicker: "Day 1", title: "Forbidden City & Tiananmen", desc: "Walk the palace halls, stand in the world\u2019s largest square, and climb Jingshan for the rooftop panorama at sunset.", note: "4-5 hours · Line 1", link: "/attractions/forbidden-city", linkText: "Forbidden City guide" },
  { n: 2, kicker: "Day 2", title: "Great Wall at Mutianyu", desc: "Cable car up, 23 watchtowers west, then the toboggan down. Forest views with a fraction of Badaling\u2019s crowds.", note: "Full day · driver", link: "/attractions/great-wall-mutianyu", linkText: "Mutianyu guide" },
  { n: 3, kicker: "Day 3", title: "Gardens & Temples", desc: "Morning tai chi at the Temple of Heaven, afternoon on Kunming Lake at the Summer Palace, evening on Guijie Street.", note: "Two districts, one plan", link: "/attractions/summer-palace", linkText: "Summer Palace guide" },
];

const planSteps = [
  { n: 1, title: "Pick dates", text: "Apr-May & Sep-Oct are best. Skip Oct 1-7 Golden Week.", href: "/best-time", linkText: "Month-by-month →" },
  { n: 2, title: "Copy itinerary", text: "Day 1 palace. Day 2 wall. Day 3 gardens — done.", href: "/collections/beijing-3-day-itinerary", linkText: "3-day plan →" },
  { n: 3, title: "Know the cost", text: "Free to CNY 100 per attraction. Our price table is always current.", href: "/blog/cost-of-beijing-trip", linkText: "Compare prices →" },
  { n: 4, title: "Sort logistics", text: "Visa, subway card, translation app, passport. Handle before you fly.", href: "/faq", linkText: "China prep →" },
];

const decidingCards = [
  { icon: "star", color: "text-[#0f766e]", title: "Is Beijing worth visiting?", text: "For history and food lovers, absolutely — it\u2019s a top-three China destination. Honest pros and cons inside.", href: "/about", linkText: "Honest assessment →" },
  { icon: "ticket", color: "text-[#d4a373]", title: "How much does it cost?", text: "3-day: free to CNY 300 depending on style. Real 2026 prices.", href: "/blog/cost-of-beijing-trip", linkText: "Budget breakdown →" },
  { icon: "map-pin", color: "text-[#2dd4bf]", title: "Too much to choose?", text: "Mutianyu or Badaling? Palace or garden? Our comparisons settle the classics.", href: "/compare/badaling-vs-mutianyu", linkText: "See comparisons →" },
];

const compareCards = [
  { title: "Badaling vs Mutianyu", icon: "building-castle", desc: "The two most famous Great Wall sections — crowds, scenery, cable car, and the toboggan.", href: "/compare/badaling-vs-mutianyu" },
  { title: "Forbidden City vs Summer Palace", icon: "building-castle", desc: "Power vs pleasure — the two grandest imperial sites and how they reward you differently.", href: "/compare/forbidden-city-vs-summer-palace" },
  { title: "Summer Palace vs Beihai Park", icon: "trees", desc: "One vast destination garden, one central interlude — which fits your itinerary.", href: "/compare/summer-palace-vs-beihai-park" },
  { title: "Lama Temple vs Temple of Heaven", icon: "temple", desc: "Living faith vs imperial ritual — atmosphere, the Buddha, and the Hall of Prayer.", href: "/compare/lama-temple-vs-temple-of-heaven" },
];

const seasons = [
  { icon: "trees", color: "#5eead4", name: "Spring", months: "Mar-May · 15-25\u00B0C", badge: "Best overall", text: "Clear skies, blooming gardens. April and May are ideal for the palace and the Wall." },
  { icon: "star", color: "#fef3c7", name: "Summer", months: "Jun-Aug · 28-35\u00B0C", badge: "Hot but lush", text: "Museums and lakeside Summer Palace shine. Start Great Wall days by 7am." },
  { icon: "heart", color: "#d4a373", name: "Autumn", months: "Sep-Nov · 10-20\u00B0C", badge: "Best photos", text: "Golden ginkgo, perfect Wall weather. Avoid Oct 1-7 Golden Week." },
  { icon: "clock", color: "#99f6e4", name: "Winter", months: "Dec-Feb · -10-5\u00B0C", badge: "Quiet & cheap", text: "A third of the crowds, half-price hotels, and snow on the Forbidden City." },
];

const checkList = [
  { step: "1", text: "Check visa requirements for your nationality", detail: "Most visitors need an L tourist visa. 54 countries qualify for 144-hour transit without a visa.", link: "/faq" },
  { step: "2", text: "Book Forbidden City tickets in advance", detail: "Released 7 days online, sold out in minutes in peak season. Passport number required.", link: "/attractions/forbidden-city" },
  { step: "3", text: "Download a translation app", detail: "Google Translate or Baidu with offline packs. Subway is English-friendly, restaurants rarely are.", link: null },
  { step: "4", text: "Get a Yikatong card on arrival", detail: "Any subway station. Tap on metro, buses, and some taxis.", link: "/subway-guide" },
  { step: "5", text: "Pick the right season", detail: "Best: April-May and September-October. Avoid National Day week.", link: "/best-time" },
  { step: "6", text: "Always carry your passport", detail: "Required for attraction entry, hotels, and police checks. Originals only.", link: null },
];

const quickPicks = [
  { label: "Things to Do", href: "/things-to-do", icon: "star" },
  { label: "Family-friendly", href: "/collections/beijing-with-kids", icon: "users" },
  { label: "Free Attractions", href: "/collections/free-beijing-attractions", icon: "ticket" },
  { label: "What to Eat", href: "#food", icon: "bowl" },
  { label: "Where to Stay", href: "#stay", icon: "bed" },
  { label: "Subway Guide", href: "/subway-guide", icon: "map-pin" },
];

const foodItems = [
  { name: "Peking Duck", desc: "Crispy skin, thin pancakes, hoisin. A tableside ritual as much as a meal.", icon: "star", recs: ["Siji Minfu", "Da Dong", "Country Kitchen"] },
  { name: "Beijing Hotpot", desc: "Copper chimney pot, thinly sliced mutton in a clear goji broth.", icon: "ticket", recs: ["Dong Lai Shun", "Haidilao"] },
  { name: "Dumplings & Noodles", desc: "Zhajiangmian, lamian, and boiled jiaozi. Cheap, fast, everywhere.", icon: "heart", recs: ["Mr Shi\u2019s Dumplings", "Huguosi"] },
  { name: "Street Food", desc: "Jianbing, tanghulu, lamb skewers. Follow the longest local line.", icon: "shopping-bag", recs: ["Guijie Street", "Nanluoguxiang"] },
  { name: "Teahouses", desc: "Jasmine, pu\u2019er, and oolong in a century-old courtyard.", icon: "clock", recs: ["Lao She Teahouse"] },
  { name: "Food Tours", desc: "Small-group hutong walks with 10+ tastings and a guide who knows the stories.", icon: "users", recs: ["Hutong food walks"] },
];

const stayAreas = [
  { name: "Dongcheng District", desc: "Historic heart. Walk to the Forbidden City, Tiananmen, and Wangfujing.", icon: "building-castle", pros: ["Top sights walkable", "Best subway links"] },
  { name: "Hutong / Gulou", desc: "Courtyard guesthouses near the Drum & Bell Towers. Wake up to jianbing and chess.", icon: "temple", pros: ["Most authentic", "Courtyard stays"] },
  { name: "Chaoyang / Sanlitun", desc: "Modern Beijing. Rooftop bars, embassy dining, international hotels.", icon: "star", pros: ["Best nightlife", "English-friendly"] },
  { name: "Wangfujing", desc: "Shopping boulevard with a 10-minute walk to the palace.", icon: "bowl", pros: ["Shopping hub", "Family-friendly"] },
];

const faqs = [
  { q: "How many days do I need to see Beijing\u2019s main attractions?", a: "3 to 4 days covers the essentials: Forbidden City, Great Wall, Temple of Heaven, and Summer Palace. See our <a href=\"/collections/beijing-3-day-itinerary\" class=\"underline text-white\">3-day itinerary</a> for a ready-made plan." },
  { q: "Do I need a visa to visit Beijing?", a: "Most foreign visitors need a Chinese tourist visa (L visa). Travelers from 54 countries qualify for 144-hour transit without visa when transiting to a third country. Always verify with your local Chinese embassy before travel." },
  { q: "Mutianyu or Badaling — which Great Wall section should I visit?", a: "Mutianyu is our recommendation for most visitors: fewer crowds and a fun toboggan slide. Badaling is the classic choice. See our <a href=\"/compare/badaling-vs-mutianyu\" class=\"underline text-white\">full comparison guide</a>." },
  { q: "How do I book tickets for the Forbidden City?", a: "Tickets are released online 7 days in advance and sell out within minutes during peak season. You must enter your passport number to book. One passport, one ticket, and no on-site sales." },
  { q: "Is it easy to get around Beijing without speaking Chinese?", a: "The subway has full English signage and announcements on all lines. Major attractions have English ticket machines. Download a translation app for restaurants and taxis." },
  { q: "What should I do after visiting the Forbidden City?", a: "Climb Jingshan Park directly north for the best panoramic view of the palace rooftops (10-min walk, CNY 2). Then walk east to Nanluoguxiang hutong for boutique shops and street food." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]*>/g, "") }
  }))
};

function fmtPrice(low: number, high: number) {
  if (low === 0 && high === 0) return "Free";
  if (low === high) return "CNY " + String(low);
  return "CNY " + String(low) + "-" + String(high);
}

const topSlugs = ["forbidden-city","great-wall-mutianyu","temple-of-heaven","summer-palace","beihai-park","great-wall-badaling","lama-temple","national-museum","jingshan-park","ming-tombs","798-art-zone","tiananmen-square","beijing-bell-tower","nanluoguxiang","beijing-zoo"];
const topPicks = topSlugs.map((s) => attractions.find((a) => a.slug === s)).filter((a): a is NonNullable<typeof a> => Boolean(a));
---

<BaseLayout title={pageTitle} description={pageDesc} image="/images/hero-tiananmen.webp">

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <!-- 1. Hero -->
  <section class="relative min-h-screen flex items-center overflow-hidden -mt-[68px]">
    <img src="/images/hero-tiananmen.webp" alt="Tiananmen at the north end of Beijing's central axis, wide shot" class="absolute inset-0 h-full w-full object-cover" width="1200" height="798" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/20 to-transparent"></div>
    <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-start justify-between gap-16 px-6 pt-32 lg:flex-row lg:items-center lg:pt-0">
      <div class="max-w-xl lg:max-w-2xl">
        <span class="inline-block rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white mb-6">Independent Travel Guide · 2026</span>
        <h1 class="font-display text-5xl font-normal tracking-tight text-white md:text-7xl lg:text-[6rem] lg:leading-[0.95] drop-shadow-md">China Attractions<br/>in Beijing</h1>
        <p class="mt-6 text-lg leading-relaxed text-white/90 md:text-xl max-w-lg drop-shadow">Real ticket prices, subway exits, and honest comparisons. A guide built for actually planning your trip.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm text-white/80">
          <span class="flex items-center gap-1.5"><Icons name="clock" size={16} class="text-white/60" /> Plan in 3-4 days</span>
          <span class="text-white/30">·</span>
          <span class="flex items-center gap-1.5"><Icons name="ticket" size={16} class="text-white/60" /> Free to CNY 100</span>
          <span class="text-white/30">·</span>
          <span class="flex items-center gap-1.5"><Icons name="calendar" size={16} class="text-white/60" /> Best: Apr-May & Sep-Oct</span>
        </div>
      </div>
      <div class="flex shrink-0 flex-col items-center lg:items-end gap-4">
        <a href="/collections/beijing-3-day-itinerary" class="group flex flex-col items-center gap-3 transition-all hover:scale-105">
          <span class="flex h-28 w-28 items-center justify-center rounded-full bg-white text-[#0f766e] shadow-2xl shadow-black/30 transition-all group-hover:shadow-[#0f766e]/30 group-hover:bg-[#ccfbf1]">
            <Icons name="arrow-right" size={36} />
          </span>
          <span class="text-sm font-semibold text-white drop-shadow-md">Start Planning</span>
        </a>
        <p class="text-xs text-white/60 max-w-[180px] text-center lg:text-right">Jump to the 3-day itinerary</p>
      </div>
    </div>
  </section>

  <!-- 2. Your 3-Day Trip -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/attractions/great-wall-mutianyu.webp')"></div>
    <div class="absolute inset-0 bg-[#0d6b62]/90"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-glass mb-4">At a Glance</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-white">Your 3-Day Trip</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-white/80">From imperial palace to mountain wall — one unforgettable day at a time.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {days.map((d) => (
          <div class="rounded-2xl bg-white/10 backdrop-blur-sm p-8 border border-white/15 scroll-reveal">
            <div class={`step-circle step-circle-${d.n} w-12 h-12 text-lg mb-5`}>{d.n}</div>
            <p class="text-xs font-bold uppercase tracking-wider text-[#5eead4] mb-1">{d.kicker}</p>
            <p class="text-xl font-bold text-white mb-2">{d.title}</p>
            <p class="text-sm font-semibold text-white/60 mb-4">{d.note}</p>
            <p class="text-sm leading-relaxed text-white/75">{d.desc}</p>
            <a href={d.link} class="mt-5 inline-flex items-center text-sm font-semibold text-[#5eead4] hover:underline">{d.linkText} →</a>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/collections/beijing-3-day-itinerary" class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-bold text-[#0f766e] shadow-lg transition-all hover:shadow-xl hover:scale-105">Full 3-Day Itinerary
          <Icons name="chevron-right" size={16} />
        </a>
        <div class="mt-4 flex justify-center gap-4 text-sm">
          <a href="/collections/beijing-with-kids" class="text-white/60 hover:text-white transition-colors">With kids</a>
          <span class="text-white/30">|</span>
          <a href="/collections/free-beijing-attractions" class="text-white/60 hover:text-white transition-colors">On a budget</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. How to Plan -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/images/attractions/forbidden-city.jpg')"></div>
    <div class="absolute inset-0 bg-white/92"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-stone mb-4">Trip Planning</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">How to Plan</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">Four steps. One hour. Done.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {planSteps.map((s) => (
          <a href={s.link} class="card-playful group rounded-2xl bg-white p-7 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
            <div class={`step-circle step-circle-${s.n} mb-4`}>{s.n}</div>
            <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e]">{s.title}</h3>
            <p class="mt-2 text-sm text-[#5c5a4c]">{s.text}</p>
            <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#0f766e] group-hover:underline">{s.linkText}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Must-Do cards -->
  <section class="relative py-24 md:py-32 overflow-hidden" id="must-do">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/images/attractions/summer-palace.webp')"></div>
    <div class="absolute inset-0 bg-[#0a3b36]/92"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-glass mb-4">The Highlights</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-white">Must-Do Experiences</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-white/80">Each has a full guide with prices, best times, and crowd-beating tips.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {topPicks.map((a) => (
          <a href={`/attractions/${a.slug}`} class="card-playful group block overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 scroll-reveal">
            <div class="aspect-[16/10] overflow-hidden">
              <img src={`/images/attractions/${a.slug}.webp`} alt={a.name} width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" loading="lazy" decoding="async" />
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-white group-hover:text-[#99f6e4]">{a.name}</h3>
                <span class="text-xs font-semibold text-[#99f6e4]">{a.freeEntry ? "Free" : fmtPrice(a.ticketLow, a.ticketHigh)}</span>
              </div>
              <p class="mt-1 text-sm text-white/70">{a.duration} · {a.subway}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="#compare-guides" class="inline-flex items-center text-sm font-semibold text-white hover:text-[#99f6e4] hover:underline">Can't decide between two sights? See our comparison guides →</a>
      </div>
    </div>
  </section>

  <!-- 6. Compare guides -->
  <section class="py-24 md:py-32 overflow-hidden gradient-warm" id="compare-guides">
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-warm mb-4">Compare & Decide</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">Attraction Comparisons</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">Stuck between two sights? Our honest side-by-side guides settle the classics.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {compareCards.map((c) => (
          <a href={c.href} class="card-playful group flex items-start gap-4 rounded-2xl bg-white p-7 shadow-sm border border-[#d5d0c4]/40 hover:border-[#99f6e4]/60 transition-all hover:-translate-y-1 scroll-reveal">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-[#0f766e] to-[#5eead4] text-white"><Icons name={c.icon} size={22} /></div>
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e] transition-colors">{c.title}</h3>
              <p class="mt-1 text-sm text-[#5c5a4c] leading-relaxed">{c.desc}</p>
              <span class="mt-3 inline-flex items-center text-sm font-semibold text-[#0f766e] group-hover:underline">Read the comparison →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Still deciding -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/images/attractions/tiananmen-square.webp')"></div>
    <div class="absolute inset-0 bg-white/88"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-stone mb-4">Still Deciding?</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">Before You Commit</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">Honest answers. No marketing spin.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {decidingCards.map((c) => (
          <a href={c.href} class="card-playful group rounded-2xl bg-white p-8 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
            <div class={`text-3xl mb-4 ${c.color}`}><Icons name={c.icon} size={30} /></div>
            <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e] transition-colors">{c.title}</h3>
            <p class="mt-2 text-sm text-[#5c5a4c]">{c.text}</p>
            <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#0f766e] group-hover:underline">{c.linkText}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. When to Visit -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/images/attractions/forbidden-city.webp')"></div>
    <div class="absolute inset-0 bg-[#0f766e]/88"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-glass mb-4">Timing</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-white">When to Visit</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-white/80">From blooming gardens to snow-dusted palaces, Beijing shifts with the seasons.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {seasons.map((s) => (
          <div class="rounded-2xl bg-white/10 backdrop-blur-sm p-7 border border-white/15 scroll-reveal">
            <p class="text-3xl mb-3" style={`color:${s.color}`}><Icons name={s.icon} size={28} /></p>
            <p class="text-lg font-bold text-white">{s.name}</p>
            <p class="text-sm text-white/60">{s.months}</p>
            <p class="mt-1 inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold text-white">{s.badge}</p>
            <p class="mt-3 text-sm leading-relaxed text-white/75">{s.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/best-time" class="inline-flex items-center text-sm font-semibold text-white hover:text-[#99f6e4] hover:underline">Full month-by-month guide with temperatures and crowds →</a>
      </div>
    </div>
  </section>

  <!-- 8. Where to Stay -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/images/attractions/nanluoguxiang.webp')"></div>
    <div class="absolute inset-0 bg-white/88"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-stone mb-4">Accommodation</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">Where to Stay in Beijing</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">Pick the right district and your trip gets twice as easy.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2" id="stay">
        {stayAreas.map((area) => (
          <div class="rounded-2xl bg-white p-8 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#ccfbf1]/40 text-[#0f766e]"><Icons name={area.icon} size={20} /></div>
              <h3 class="text-xl font-bold text-[#1c1a16]">{area.name}</h3>
            </div>
            <p class="text-sm leading-relaxed text-[#5c5a4c] mb-4">{area.desc}</p>
            <div class="flex flex-wrap gap-2">
              {area.pros.map((p) => <span class="inline-flex items-center rounded-full bg-[#ccfbf1]/40 text-[#0f766e] px-3 py-1 text-xs font-semibold">{p}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Checklist -->
  <section class="py-24 md:py-32 overflow-hidden gradient-mist" id="before-you-go">
    <div class="relative z-10 mx-auto max-w-4xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-primary mb-4">Before You Go</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">Pre-Trip Checklist</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">Six things every Beijing visitor should do before arriving.</p>
      </div>
      <div class="space-y-4">
        {checkList.map((item) => (
          <div class="flex gap-4 p-5 rounded-2xl bg-white border border-[#d5d0c4]/40 shadow-sm scroll-reveal">
            <div class={`step-circle step-circle-${Number(item.step) % 4 === 0 ? 4 : Number(item.step)} shrink-0`}>{item.step}</div>
            <div>
              {item.link ? <a href={item.link} class="font-semibold text-[#1c1a16] hover:text-[#0f766e] transition-colors">{item.text} →</a> : <p class="font-semibold text-[#1c1a16]">{item.text}</p>}
              <p class="text-sm text-[#5c5a4c] mt-1">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. Food + quick picks -->
  <section class="py-24 md:py-32 overflow-hidden" id="food">
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-warm mb-4">Food & Shortcuts</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">What to Eat in Beijing</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">From imperial banquets to street-corner snacks.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {foodItems.map((item) => (
          <div class="card-playful rounded-2xl bg-white p-7 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[#0f766e]"><Icons name={item.icon} size={20} /></span>
              <h3 class="text-lg font-bold text-[#1c1a16]">{item.name}</h3>
            </div>
            <p class="text-sm text-[#5c5a4c] leading-relaxed mb-3">{item.desc}</p>
            <div class="flex flex-wrap gap-1.5">
              {item.recs.map((r) => (
                <span class="inline-flex items-center rounded-full bg-[#edeae3] text-[#5c5a4c] px-3 py-1 text-xs font-medium">{r}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3" id="categories">
        {quickPicks.map((pick) => (
          <a href={pick.href} class="card-playful group rounded-2xl bg-white p-5 text-center shadow-sm border border-[#d5d0c4]/40 hover:border-[#99f6e4]/50">
            <div class="flex justify-center mb-2 text-[#0f766e]"><Icons name={pick.icon} size={22} /></div>
            <span class="text-xs font-semibold text-[#1c1a16] group-hover:text-[#0f766e] transition-colors">{pick.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/images/attractions/temple-of-heaven.webp')"></div>
    <div class="absolute inset-0 bg-[#0a3f3b]/92"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6" id="faq">
      <div class="text-center mb-14">
        <span class="tag tag-glass mb-4">Quick Answers</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-white">Frequently Asked Questions</h2>
      </div>
      <div class="mt-6 mb-10 flex flex-wrap justify-center gap-2">
        {faqs.map((item, i) => (
          <a href={`#faq-${i}`} class="rounded-full border border-white/20 bg-white/10 backdrop-blur-sm px-4 py-2 text-sm text-white/80 transition-all hover:border-white/50 hover:text-white hover:bg-white/20">{item.q}</a>
        ))}
      </div>
      <div class="max-w-3xl mx-auto space-y-6">
        {faqs.map((item, i) => (
          <div id={`faq-${i}`} class="scroll-reveal p-6 rounded-2xl bg-white border border-[#d5d0c4]/40 shadow-sm">
            <h3 class="text-lg font-bold text-[#0f766e] flex items-start gap-3">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#14b8a6] to-[#5eead4] text-white text-xs font-bold">?</span>
              {item.q}
            </h3>
            <div class="mt-3 text-[#5c5a4c] leading-relaxed pl-10" set:html={item.a}></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>